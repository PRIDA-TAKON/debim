# yaml-language-server: $schema=../../debim.schema.json
# ==============================================================================
# Model: Baan Thai L-Shape (บ้านไทยทรง L-Shapeร่วมสมัย)
# Benchmark Showcase: 225+ Element Comprehensive Declarative OpenBIM Model
# Features: Substructure stub columns, cantilever beams, grid openings,
#           composite L-hip roof, compound floor finishes, and complete MEP.
# Format: Official debim Language File (.debim) v0.8.1
# ==============================================================================

schema: "IFC4-Minimal"
version: "0.8.1"

project:
  id: "PRJ-THAI-L-HOUSE-2025"
  name: "Baan Thai L-Shape Contemporary Residence (บ้านพักอาศัย ค.ส.ล. 1 ชั้น ทรง L)"
  units:
    length: "METER"
    area: "SQUARE_METER"
    volume: "CUBIC_METER"

site:
  name: "Chiang Mai Residential Estate, Thailand"
  bounding_box: [-5.0, -5.0, 25.0, 20.0]

spatial_structure:
  storeys:
    - id: "Foundation"
      name: "Foundation & Underground Level"
      elevation: -1.50
      height: 1.00
    - id: "Ground"
      name: "Ground Level (ระดับดินเดิม)"
      elevation: -0.50
      height: 0.50
    - id: "FL1"
      name: "First Floor Living Level (+1.00m)"
      elevation: 1.00
      height: 3.50
    - id: "Roof"
      name: "Roof Level (ระดับอกไก่)"
      elevation: 4.50
      height: 2.20

grids:
  axes_x:
    "1": 0.00
    "2": 3.50
    "3": 7.00
    "4": 10.50
    "5": 14.00
    "6": 17.50
  axes_y:
    "A": 0.00
    "B": 3.50
    "C": 7.00
    "D": 10.50
    "E": 14.00

materials:
  - id: "RC_CONCRETE_240"
    name: "Reinforced Concrete 240 ksc"
    category: "concrete"
    unit_cost_ref: "MAT-CONC-240"
  - id: "BRICK_MON"
    name: "Red Clay Mon Brick Masonry (อิฐมอญก่อ)"
    category: "masonry"
    unit_cost_ref: "MAT-BRICK-MON"
  - id: "AAC_BLOCK"
    name: "Autoclaved Aerated Concrete 7.5cm (อิฐมวลเบา)"
    category: "masonry"
    unit_cost_ref: "MAT-AAC-75"
  - id: "GRANITO_60"
    name: "Granito Tile 60x60cm (กระเบื้องแกรนิตโต้)"
    category: "finishes"
    unit_cost_ref: "MAT-GRANITO"
  - id: "STEEL_C_CHANNEL"
    name: "Light Gauge C-Channel Roof Truss Steel"
    category: "steel"
    unit_cost_ref: "MAT-STEEL-TRUSS"
  - id: "ROOF_CPAC"
    name: "CPAC Monier Concrete Roof Tile (กระเบื้องซีแพค)"
    category: "other"
    unit_cost_ref: "MAT-ROOF-CPAC"

