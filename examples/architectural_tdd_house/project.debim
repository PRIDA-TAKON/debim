schema: IFC4-Minimal
project:
  id: PRJ-TDD-RESIDENTIAL-2026
  name: Baan TDD Residential Benchmark House
  description: Complete 3D BIM Model generated from relative touching spaces via debim
    derive
  units:
    length: METER
    area: SQUARE_METER
    volume: CUBIC_METER
spatial_structure:
  storeys:
  - id: STOREY-1
    name: Ground Floor (FL1)
    elevation: 0.0
    height: 2.8
grids:
  axes_x:
    '1': -5.5
    '2': 0.0
    '3': 2.0
    '4': 3.5
    '5': 4.5
    '6': 6.0
    '7': 7.0
    '8': 9.5
    '9': 11.0
    '10': 12.0
    '11': 14.5
  axes_y:
    A: -0.5
    B: 0.0
    C: 2.0
    D: 4.0
    E: 6.0
    F: 6.5
    G: 7.0
    H: 10.0
    I: 10.5
    J: 11.0
    K: 12.5
materials:
- id: CONCRETE
  name: Reinforced Concrete 240 ksc
  category: structural
  unit_cost_ref: MAT-CONC-240KSC
- id: BRICK_MASONRY
  name: Clay Brick Masonry
  category: architectural
  unit_cost_ref: MAT-BRICK-MASONRY
- id: GLASS
  name: Clear Float Glass 6mm
  category: architectural
  unit_cost_ref: MAT-GLASS-6MM
- id: STEEL
  name: Structural Steel SS400
  category: structural
  unit_cost_ref: MAT-STEEL-SS400
